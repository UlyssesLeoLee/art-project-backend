{
  "name": "art-project-backend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for art-project-client (Unity card RPG)",
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "build:proto": "python scripts/gen_registry.py shared/proto/protocols.json && python scripts/gen_protocol_doc.py",
    "start:http": "node --enable-source-maps services/http/dist/main.js",
    "start:tcp": "node --enable-source-maps services/tcp/dist/main.js",
    "dev:http": "tsx watch services/http/src/main.ts",
    "dev:tcp": "tsx watch services/tcp/src/main.ts",
    "test": "node --import tsx tests/smoke.ts",
    "lint": "eslint . --ext .ts",
    "db:migrate": "node --import tsx db/migrations/run.ts",
    "test:e2e": "python tests/e2e_client.py",
    "db:seed": "node --import tsx db/seeds/seed.ts",
    "test:smoke": "node --import tsx tests/smoke.ts",
    "test:http": "node --import tsx tests/http-api.test.ts",
    "test:admin": "node --import tsx tests/admin-cli.test.ts",
    "test:all": "npm run test:smoke && npm run test:http && npm run test:admin && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "express": "^4.19.0",
    "fast-glob": "^3.3.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.20.4",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
